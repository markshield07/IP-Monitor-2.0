# Copy this file, rename the copy to ".env", and fill in your real values.
# The .env file stays on your computer and is never uploaded to GitHub.

# Workato webhook address (required for alerts)
WORKATO_WEBHOOK_URL=

# Optional email backup (leave blank to skip email)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
